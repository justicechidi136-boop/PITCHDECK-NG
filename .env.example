# Local development environment variables
# Copy to .env and adjust as needed for your machine

# Docker host port mappings (avoid conflicts with local PostgreSQL/Redis)
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# PostgreSQL
POSTGRES_USER=pitchdeck
POSTGRES_PASSWORD=pitchdeck_dev
POSTGRES_DB=pitchdeck
DATABASE_URL=postgresql://pitchdeck:pitchdeck_dev@localhost:15432/pitchdeck?schema=public

# Redis
REDIS_PASSWORD=pitchdeck_redis_dev
REDIS_URL=redis://:pitchdeck_redis_dev@localhost:16379

# MinIO (local S3-compatible storage)
MINIO_ROOT_USER=pitchdeck_minio
MINIO_ROOT_PASSWORD=pitchdeck_minio_dev
MINIO_ENDPOINT=localhost
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=pitchdeck-uploads
MINIO_USE_SSL=false

# API
NODE_ENV=development
PORT=4000
API_PREFIX=v1
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# Web apps
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
WEB_BASE_URL=http://localhost:3000
ADMIN_WEB_BASE_URL=http://localhost:3001

# Authentication
AUTH_JWT_SECRET=dev-jwt-secret-minimum-32-characters-long
AUTH_JWT_ACCESS_EXPIRES=15m
AUTH_REFRESH_EXPIRES=7d
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_CSRF_SECRET=dev-csrf-secret-minimum-32-characters

# Email (log provider for dev; smtp for production; capture for E2E/CI test runs)
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@pitchdeck.ng
ENABLE_TEST_ENDPOINTS=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Super-admin bootstrap (run via pnpm admin:bootstrap — not seeded)
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=

# E2E / CI test helpers (never enable in production)
# ENABLE_TEST_ENDPOINTS=true exposes GET/DELETE /v1/test/emails when EMAIL_PROVIDER=capture

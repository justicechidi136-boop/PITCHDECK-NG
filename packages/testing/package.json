{
  "name": "@pitchdeck/testing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "import": "./dist/e2e/index.js",
      "require": "./dist/e2e/index.js",
      "default": "./dist/e2e/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --passWithNoTests"
  },
  "dependencies": {
    "@pitchdeck/contracts": "workspace:*",
    "@pitchdeck/database": "workspace:*",
    "argon2": "^0.45.0"
  },
  "devDependencies": {
    "@pitchdeck/config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  }
}

# API Environment Variables
NODE_ENV=development
PORT=4000
API_PREFIX=v1
APP_VERSION=0.1.0

# Database
DATABASE_URL=postgresql://pitchdeck:pitchdeck_dev@localhost:5432/pitchdeck?schema=public

# Redis
REDIS_URL=redis://:pitchdeck_redis_dev@localhost:6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info

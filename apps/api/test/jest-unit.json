{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "env.validation.spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@pitchdeck/database$": "<rootDir>/../../../packages/database/src/index.ts",
    "^@pitchdeck/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts"
  }
}
